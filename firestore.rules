rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict RBAC & Validation Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'manjitranjan180513@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Strict Owner or Verified Admin only — ordinary users can NEVER read other users' records
    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // Ensure no passwords, hashes, OTPs, or secrets are ever written to User documents
    function isValidUser(data) {
      return data.uid is string &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             !('password' in data) &&
             !('passwordHash' in data) &&
             !('otp' in data) &&
             !('accessToken' in data) &&
             !('sessionToken' in data);
    }

    // Ensure LoginActivity documents never contain passwords or tokens
    function isValidLoginActivity(data) {
      return data.keys().hasAll(['event_id', 'uid', 'event_type', 'authentication_method', 'event_timestamp', 'success_status']) &&
             data.event_id is string &&
             data.uid is string &&
             data.event_type in ['SIGN_IN', 'CREATE_ACCOUNT', 'GOOGLE_AUTH', 'GUEST_PASS', 'LOGOUT', 'FAILED_LOGIN'] &&
             data.authentication_method in ['Google', 'Email', 'Guest'] &&
             data.event_timestamp is number &&
             data.success_status is bool &&
             !('password' in data) &&
             !('passwordHash' in data) &&
             !('token' in data);
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'categoryId', 'userId', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 7 && data.keys().size() <= 9 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 1048576 &&
             data.userId == request.auth.uid &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('level' in data) || (data.level in ['beginner', 'intermediate', 'advanced', 'mastered'])) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'priority', 'completed', 'userId', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 7 && data.keys().size() <= 13 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.priority in ['low', 'medium', 'high'] &&
             data.completed is bool &&
             data.userId == request.auth.uid &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidTaskFolder(data) {
      return data.keys().hasAll(['id', 'name', 'userId', 'createdAt']) &&
             data.keys().size() >= 4 && data.keys().size() <= 5 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 64 &&
             data.userId == request.auth.uid &&
             data.createdAt is number;
    }

    function isValidClassroom(data) {
      return data.keys().hasAll(['id', 'name', 'joinCode', 'teacherId', 'studentIds', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.joinCode is string && data.joinCode.size() == 6 &&
             data.teacherId is string && data.teacherId == request.auth.uid &&
             data.studentIds is list && data.studentIds.size() <= 200 &&
             data.createdAt is number;
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll(['id', 'categoryId', 'score', 'total', 'userId', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.categoryId is string && data.categoryId.size() <= 128 &&
             data.score is number && data.score >= 0 &&
             data.total is number && data.total > 0 &&
             data.userId == request.auth.uid &&
             data.createdAt is number;
    }

    function isValidAiChat(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 256 &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    // Global Chat
    match /globalChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // Admin-Only Login Activity Collection
    match /login_activity/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidLoginActivity(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Strictly Isolated User Profiles (Only Owner or Admin can read/write; only Admin can list all users)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    (!('role' in request.resource.data) || isAdmin() || request.resource.data.role in ['Student', 'Guest', 'student', 'guest']);
      allow delete: if isAdmin();

      // User notes subcollection
      match /notes/{noteId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(request.resource.data);
        allow update: if isOwner(userId) && isValidNote(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User tasks subcollection
      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User quiz results
      match /quizResults/{quizId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(quizId) && isValidQuizResult(request.resource.data);
        allow update: if isOwner(userId) && isValidQuizResult(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User task folders subcollection
      match /taskFolders/{folderId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(folderId) && isValidTaskFolder(request.resource.data);
        allow update: if isOwner(userId) && isValidTaskFolder(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User AI Voice & Chat conversations storage
      match /aiChats/{chatId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidAiChat(request.resource.data);
        allow update: if isOwner(userId) && isValidAiChat(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /savedSolutions/{solutionId} {
        allow read, write: if isOwner(userId);
      }

      match /learningHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /notebooks/{notebookId} {
        allow read, write: if isOwner(userId);
      }

      match /flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /practiceTests/{testId} {
        allow read, write: if isOwner(userId);
      }

      match /documents/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /joinCodes/{code} {
      allow get, create: if isSignedIn();
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/classrooms/$(resource.data.classroomId)).data.teacherId == request.auth.uid;
    }

    match /classrooms/{classroomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidClassroom(request.resource.data);
      allow update, delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /homeworks/{homeworkId} {
        allow read, write: if isSignedIn();

        match /submissions/{submissionId} {
          allow read, write: if isSignedIn();
        }
      }
    }

    match /userSubscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}
